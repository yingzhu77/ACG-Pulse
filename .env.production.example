# ACG Pulse - Production Environment Configuration
# Copy this file to .env and fill in the values

# AI Provider (required for sentiment analysis)
# Options: openrouter | deepseek | mimo
AI_PROVIDER=deepseek

# DeepSeek (production default)
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# OpenRouter (alternative)
# AI_PROVIDER=openrouter
# OPENROUTER_API_KEY=your_openrouter_api_key_here
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_MODEL=deepseek/deepseek-v3.2

# Xiaomi MiMo Token Plan (alternative)
# AI_PROVIDER=mimo
# MIMO_API_KEY=tp-xxxxx
# MIMO_BASE_URL=https://token-plan-cn.xiaomimimo.com/v1
# MIMO_MODEL=mimo-v2.5

# Admin (required - CHANGE THESE!)
ADMIN_PASSWORD=your_secure_password_here
ADMIN_JWT_SECRET=your_random_secret_here_at_least_32_chars

# Public origin and reverse proxy hops
CLIENT_URL=https://your-domain.example
TRUST_PROXY_HOPS=1

# Bilibili Configuration
# 主路径：自建 RSSHub。docker-compose.yml 会把 BILIBILI_COOKIE 映射为 RSSHub 所需的
# per-uid 变量 BILIBILI_COOKIE_<uid>。app 容器默认不接收该 Cookie，采集路径不直连 B站。
# 例外：头像补全仍会匿名直连 B站 acc/info，失败不影响采集。
BILIBILI_COOKIE=your_bilibili_cookie_here
# 可选：RSSHub B站路由的动态参数；不确定时留空。
BILIBILI_DM_IMG_LIST=
# 仅显式排障/备用时开启；开启后 app 会绕过 RSSHub 直连 B站，风控风险由部署方承担。
BILIBILI_DIRECT_API_FALLBACK=false
# 如需给不同 UID 使用不同账号，直接在 docker-compose.yml 中把对应
# BILIBILI_COOKIE_<uid> 改为独立环境变量，不要提交真实 Cookie。

# Feed limit (max items to keep in database)
MAX_FEED_ITEMS=2000

# Health log retention (days, default: 30)
HEALTH_LOG_RETENTION_DAYS=30
ANALYSIS_TASK_COMPLETED_RETENTION_DAYS=14
ANALYSIS_TASK_FAILED_RETENTION_DAYS=30

# Operations monitoring and stats cache
STATS_CACHE_TTL_MS=30000
API_METRICS_WINDOW_MS=900000
API_METRICS_SAMPLE_LIMIT=2000
API_SLOW_REQUEST_MS=500
API_CRITICAL_REQUEST_MS=1500

# Report timezone (default: Asia/Shanghai)
REPORT_TIMEZONE=Asia/Shanghai
